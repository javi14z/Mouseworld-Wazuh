        <mxCell id="v6_FmtBowVPNPPiEho-n-30" value="&lt;p class=&quot;&quot; data-end=&quot;323&quot; data-start=&quot;226&quot;&gt;&lt;font&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(48, 152, 22);&quot;&gt;Control plane:&lt;/font&gt;&lt;font color=&quot;#35ff17&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Realizar análisis de los componentes desplegados&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;&quot; data-end=&quot;323&quot; data-start=&quot;226&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;desde el interior&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;utilizando agentes Wazuh.&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;ul data-end=&quot;890&quot; data-start=&quot;304&quot;&gt;&lt;li class=&quot;&quot; data-end=&quot;443&quot; data-start=&quot;304&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;443&quot; data-start=&quot;306&quot;&gt;Detectar reinicios de servicios, contenedores o pods mediante&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;el monitoreo&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;de&amp;nbsp;logs del sistema&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;ul data-end=&quot;890&quot; data-start=&quot;304&quot;&gt;&lt;li class=&quot;&quot; data-end=&quot;565&quot; data-start=&quot;444&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;565&quot; data-start=&quot;446&quot;&gt;Supervisar la instalación o descarga de archivos maliciosos mediante FIM&amp;nbsp;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(File Integrity Monitoring) y análisis de logs&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;ul data-end=&quot;890&quot; data-start=&quot;304&quot;&gt;&lt;li class=&quot;&quot; data-end=&quot;736&quot; data-start=&quot;566&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;736&quot; data-start=&quot;568&quot;&gt;Detectar vulnerabilidades conocidas (CVEs) presentes en el sistema mediante la&amp;nbsp;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;base de datos de paquetes y escaneo de inventario (Syscollector + Vulnerability Detector)&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;ul data-end=&quot;890&quot; data-start=&quot;304&quot;&gt;&lt;li class=&quot;&quot; data-end=&quot;890&quot; data-start=&quot;737&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;890&quot; data-start=&quot;739&quot;&gt;Detectar intentos de acceso no autorizado por fuerza bruta (por ejemplo, múltiples&amp;nbsp;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;intentos fallidos de SSH) mediante análisis de logs de autenticación&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="1" vertex="1">
